---
interface Props {
  slot?: string;
  label?: string;
}

const googleAdSenseClientId = import.meta.env.PUBLIC_GOOGLE_ADSENSE_CLIENT_ID;
const slot = Astro.props.slot ?? import.meta.env.PUBLIC_GOOGLE_ADSENSE_SLOT_ID;
const label = Astro.props.label ?? "Advertisement";
const shouldRenderAd = Boolean(googleAdSenseClientId && slot);
---

{
  shouldRenderAd ? (
    <aside
      class="pointer-events-none fixed inset-x-0 bottom-0 z-40 flex justify-center px-3 pb-3"
      aria-label={label}
    >
      <div class="pointer-events-auto w-full max-w-[728px] overflow-hidden rounded-2xl border border-[var(--border)] bg-[var(--bg)] p-1.5 shadow-[0_10px_30px_rgba(15,23,42,0.22)]">
        <ins
          class="adsbygoogle block h-[50px] w-full md:h-[90px]"
          data-ad-client={googleAdSenseClientId}
          data-ad-slot={slot}
          data-ad-format="auto"
          data-full-width-responsive="true"
        ></ins>
      </div>
      <script is:inline>
        try {
          window.adsbygoogle = window.adsbygoogle || [];
          window.adsbygoogle.push({});
        } catch {
          // Ignore ad blocker or third-party script failures.
        }
      </script>
    </aside>
  ) : null
}
